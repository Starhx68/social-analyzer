NODE_ENV=development
PORT=3000

# 数据库
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guobu

# Supabase
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT
JWT_SECRET=your-jwt-secret-here-change-in-production
JWT_EXPIRES_IN=24h

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# OCR服务
OCR_SERVICE_PROVIDER=siliconflow
# PaddleOCR (如需本地部署，需启动 paddleocr 服务)
PADDLEOCR_URL=http://localhost:8868
# SiliconFlow OCR (DeepSeek-OCR) - 推荐生产环境使用
SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-Janus
SILICONFLOW_TEXT_MODEL=deepseek-ai/DeepSeek-V3

# 腾讯OCR (Legacy)
TENCENT_OCR_SECRET_ID=your-secret-id
TENCENT_OCR_SECRET_KEY=your-secret-key

# 文件存储
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=guobu-files
MINIO_USE_SSL=false

# 短信服务
SMS_SERVICE_PROVIDER=tencent
TENCENT_SMS_SECRET_ID=your-secret-id
TENCENT_SMS_SECRET_KEY=your-secret-key
TENCENT_SMS_APP_ID=your-app-id
TENCENT_SMS_SIGN_NAME=国补订单
TENCENT_SMS_TEMPLATE_CODE=123456

# 第三方接口
AUDIT_SYSTEM_API_URL=https://audit-system.example.com/api
AUDIT_SYSTEM_API_KEY=your-api-key
CENTRAL_PLATFORM_API_URL=https://central-platform.example.com/api
CENTRAL_PLATFORM_API_KEY=your-api-key

# WebService接口 (HG800025 等)
WEBSERVICE_URL=http://10.10.33.11/HDEP/ProcessWeb
WEBSERVICE_AUTH_USER=APPUser
WEBSERVICE_AUTH_PWD=107898
WEBSERVICE_AUTH_IP=10.10.1.999
WEBSERVICE_AUTH_TOKEN=1A682300CCE8D608ABProd

# Oracle数据库同步
ORACLE_ENABLED=false
ORACLE_USER=system
ORACLE_PASSWORD=oracle
ORACLE_CONNECT_STRING=localhost:1521/helowin
ORACLE_CLIENT_LIB_DIR=C:\oracle\instantclient_19_8
ORACLE_TNS_ADMIN=C:\oracle\instantclient_19_8\network\admin
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=5
ORACLE_POOL_INCREMENT=1
ORACLE_SYNC_INTERVAL_SECONDS=10
ORACLE_SYNC_LOOKBACK_SECONDS=5
ORACLE_SYNC_INITIAL_TIME=2024-01-01T00:00:00Z

# 图片处理
IMAGE_MAX_SIZE=3145728
IMAGE_QUALITY=85
IMAGE_FORMATS=png,jpg,jpeg

# 特权组织（可配置多个组织编码，逗号分隔，不区分大小写）
PRIVILEGED_ORG_CODES=demo001

# 日志
LOG_LEVEL=info
LOG_DIR=./logs
